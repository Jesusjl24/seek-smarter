# Loaded from the process working directory. Existing process environment values always win.
# HTTP server
HOST=0.0.0.0
PORT=3100
DATABASE_PATH=./data/seek-smarter.db
UPLOAD_DIR=./data/uploads
CORS_ORIGIN=http://localhost:8080
PUBLIC_URL=http://localhost:3100

# Generate a long random value for production. Signup defaults to true.
JWT_SECRET=replace-with-a-long-random-secret
AUTH_ALLOW_SIGNUP=true
COOKIE_SECURE=false

# Scheduled searches (cron syntax); use "off" to disable.
PIPELINE_CRON=0 * * * *

# Agent polling. If omitted, generated at data/agent-token.txt (mode 0600).
AGENT_API_TOKEN=
# Optional user id to expose when more than one account exists.
AGENT_USER_ID=

# Default AI provider is xAI Grok (OpenAI-compatible at https://api.x.ai/v1).
# Default model grok-4.3 is the current cheapest capable general/fast-tier model
# after the May 15, 2026 retirement of grok-3-mini / grok-4-fast / grok-4-1-fast.
# Pricing (https://docs.x.ai/docs/models and https://docs.x.ai/docs/models/grok-4.3):
# $1.25 / 1M input, $0.20 cached, $2.50 / 1M output for prompts under 200k tokens.
AI_PROVIDER=xai
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.3
# Optional cheaper coding model: XAI_MODEL=grok-build-0.1 ($1 / $2 per 1M).

# Alternatives:
# AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional but recommended for SEEK scraping. Read from process.env first.
# Without it, scraping makes a best-effort direct SEEK request.
FIRECRAWL_API_KEY=
