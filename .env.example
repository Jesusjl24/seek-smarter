# Loaded from the process working directory. Existing process environment values always win.
# HTTP server
HOST=0.0.0.0
PORT=3100
DATABASE_PATH=./data/seek-smarter.db
UPLOAD_DIR=./data/uploads
CORS_ORIGIN=http://localhost:8080
PUBLIC_URL=http://localhost:3100

# Generate a long random value for production. Signup defaults to true.
JWT_SECRET=replace-with-a-long-random-secret
AUTH_ALLOW_SIGNUP=true
COOKIE_SECURE=false

# Scheduled searches (cron syntax); use "off" to disable.
PIPELINE_CRON=0 * * * *

# Agent polling. If omitted, generated at data/agent-token.txt (mode 0600).
AGENT_API_TOKEN=
# Optional user id to expose when more than one account exists.
AGENT_USER_ID=

# AI_PROVIDER=openai supports OpenAI-compatible services via OPENAI_BASE_URL.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional. Without it, scraping makes a best-effort direct SEEK request.
FIRECRAWL_API_KEY=
